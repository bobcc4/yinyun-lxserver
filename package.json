{
  "name": "yinyun",
  "version": "1.6.7",
  "private": true,
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "prebuild": "node scripts/download-binary.js && node scripts/update-build-hash.js",
    "build": "rimraf server && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "prestart": "node scripts/download-binary.js && node scripts/update-build-hash.js",
    "start": "node ./index.js",
    "predev": "node scripts/update-build-hash.js",
    "dev": "nodemon",
    "predev1": "node scripts/update-build-hash.js",
    "dev1": "nodemon --exec \"tsx --inspect=127.0.0.1:9301 ./src/index.ts\"",
    "predev2": "node scripts/update-build-hash.js",
    "dev2": "nodemon --exec \"cmd /c start /affinity 1 /b /wait tsx --inspect=127.0.0.1:9302 ./src/index.ts\"",
    "prd": "pm2 start ecosystem.config.js --env production",
    "publish": "node publish",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "electron:build": "npm run build",
    "electron:dist": "npm run electron:build && electron-builder"
  },
  "engines": {
    "node": ">= 22.12.0",
    "npm": ">= 10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobcc4/yinyun-lxserver.git"
  },
  "author": {
    "name": "bobcc4",
    "email": "bobcc4@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bobcc4/yinyun-lxserver/issues"
  },
  "homepage": "https://github.com/bobcc4/yinyun-lxserver#readme",
  "dependencies": {
    "@foobar404/wave": "^2.0.5",
    "@types/formidable": "^3.5.1",
    "archiver": "^8.0.0",
    "brace-expansion": "^5.0.9",
    "crypto-js": "^4.2.0",
    "file-type": "^22.0.1",
    "formidable": "^3.5.4",
    "log4js": "^6.9.1",
    "lru-cache": "^11.5.2",
    "module-alias": "^2.3.4",
    "music-tag-native": "^1.0.0",
    "needle": "^3.3.1",
    "socks-proxy-agent": "^10.1.0",
    "tunnel": "^0.0.6",
    "unzipper": "^0.12.5",
    "vm2": "^3.11.6",
    "webdav": "^5.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/recommended": "^1.0.13",
    "@types/archiver": "^8.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/needle": "^3.3.0",
    "@types/tunnel": "^0.0.7",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chalk": "^6.0.0",
    "changelog-parser": "^4.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-config-love": "^155.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.25",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "ext": "js,ts",
    "ignore": [
      "data/",
      "logs/",
      "config.js"
    ],
    "exec": "npx tsx ./src/index.ts"
  }
}
